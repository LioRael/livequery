+//! Temporary diagnostic-only instrumentation; never a release artifact.
+use std::io::Write;
+fn clock(id: libc::clockid_t) -> Option<u64> {
+    let mut t = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: initialized writable output and a supported local clock identifier.
+    if unsafe { libc::clock_gettime(id, &mut t) } != 0 { return None; }
+    u64::try_from(t.tv_sec).ok()?.checked_mul(1_000_000_000)?.checked_add(u64::try_from(t.tv_nsec).ok()?)
+}
+#[derive(Debug, serde::Serialize)]
+struct Point { phase: &'static str, row: usize, wall_ns: Option<u64>, cpu_ns: Option<u64> }
+#[derive(Debug)]
+pub struct Span { kind: &'static str, tid: u64, pthread_handle: u64, points: Vec<Point>, start: u64, failed: bool }
+impl Span {
+    pub fn new(kind: &'static str) -> Self {
+        let mut tid = 0;
+        // SAFETY: null selects the current thread; tid is initialized writable storage.
+        unsafe { libc::pthread_threadid_np(0, &mut tid); }
+        thread_local! {static REGISTERED: std::cell::Cell<bool> = const {std::cell::Cell::new(false)};}
+        REGISTERED.with(|registered| {if !registered.replace(true) {
+            if let Ok(dir)=std::env::var("LQ_DIAGNOSTIC_DIR") {
+                let _=std::fs::write(std::path::Path::new(&dir).join(format!("{}-{}.tid",std::process::id(),tid)),b"thread_id64");
+            }
+        }});
+        let mut s = Self {kind,tid,pthread_handle: unsafe { libc::pthread_self() } as u64,points:Vec::with_capacity(48), start:clock(libc::CLOCK_MONOTONIC).unwrap(),failed:false};
+        s.mark("start",0);
+        static INJECT: std::sync::Once = std::sync::Once::new();
+        INJECT.call_once(|| { if std::env::var_os("LQ_VALIDATE_PAUSE").is_some() {
+            // SAFETY: opt-in diagnostic injection stops this process until the test controller resumes it.
+            unsafe { libc::raise(libc::SIGSTOP); }
+        }});
+        s
+    }
+    pub fn mark(&mut self, phase: &'static str, row: usize) {
+        self.points.push(Point {phase,row,wall_ns:clock(libc::CLOCK_MONOTONIC),cpu_ns:clock(libc::CLOCK_THREAD_CPUTIME_ID)});
+    }
+    pub fn deadline(&mut self) {self.failed=true;self.mark("deadline",0);}
+}
+#[derive(serde::Serialize)]
+struct Event { kind: &'static str, tid: u64, pthread_handle: u64, wall_ns: u64, deadline: bool, points: Vec<Point> }
+struct Sink { events: Vec<Event>, dropped: usize }
+impl Drop for Sink {
+    fn drop(&mut self) {
+        // Flush only when the diagnostic thread exits, outside measured operations.
+        if self.events.is_empty() { return; }
+        if let Ok(dir) = std::env::var("LQ_DIAGNOSTIC_DIR") {
+            let path = std::path::Path::new(&dir).join(format!("{}-{}.jsonl", std::process::id(), self.events[0].tid));
+            if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+                for event in &self.events { let _ = serde_json::to_writer(&mut f, event); let _ = writeln!(f); }
+                let _ = writeln!(f, "{}", serde_json::json!({"diagnostic_dropped_events": self.dropped}));
+            }
+        }
+    }
+}
+thread_local! { static SINK: std::cell::RefCell<Sink> = const { std::cell::RefCell::new(Sink { events: Vec::new(), dropped: 0 }) }; }
+impl Drop for Span {
+    fn drop(&mut self) {
+        self.mark("end", 0);
+        let elapsed = clock(libc::CLOCK_MONOTONIC).unwrap() - self.start;
+        if elapsed < 50_000_000 && !self.failed { return; }
+        SINK.with(|sink| {
+            let mut sink = sink.borrow_mut();
+            if sink.events.len() == 256 { sink.dropped += 1; return; }
+            sink.events.push(Event { kind: self.kind, tid: self.tid, pthread_handle: self.pthread_handle, wall_ns: elapsed, deadline: self.failed, points: std::mem::take(&mut self.points) });
+        });
+    }
+}
